# Local, uncommitted overrides for the dylext tester/dev scripts.
# Copy this file to `.local.env` (gitignored) and set values for your environment.
# The committed defaults are public (Docker Hub, docker.io) so the repo is registry-agnostic.
#
# Registry mirror prefix used for pulled images (pgvector, node, python, go, ...):
#   MIRROR=my-mirror.example.com/dockerhub-remote
#
# Or override individual images / proxies directly:
#   PGVECTOR_IMAGE=my-mirror.example.com/pgvector/pgvector:pg16
#   REGISTRY=my-mirror.example.com/library
#   GOPROXY=https://my-goproxy.example.com
